#!name = 扫描全能王
#!desc = 修改扫描全能王会员与部分权益参数（学习与测试用途）
#!date = 2026-11-24 22:18
#!author = 学习示例
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CamScanner.png

[Script]
response if ${url} ~= /^https?:\/\/[^\/]+\.(intsig\.net|camscanner\.com)\// then script("CamScanner.js") with requires_body=true, timeout=10, tag="CamScanner"

[MitM]
hostname = *.camscanner.com, *.intsig.net
