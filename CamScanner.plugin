[Script]
response if ${url} ~= /^https?:\/\/[^\/]+\.(intsig\.net|camscanner\.com)\// then script("https://raw.githubusercontent.com/cjhasdzzz/Loon/main/CamScanner.js") with requires_body=true, timeout=10, tag="CamScanner"

[MitM]
hostname = *.camscanner.com, *.intsig.net

